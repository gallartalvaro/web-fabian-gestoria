# ============================================================
# Valentramites — configuración del servidor (Apache / LiteSpeed)
# Hostinger lee este archivo desde la raíz de public_html.
# ============================================================

# Página que se sirve al entrar en una carpeta. Si falta esta
# directiva y el listado de directorios está desactivado, el
# servidor responde 403 en lugar de abrir la portada.
DirectoryIndex index.html index.htm

# No mostrar el contenido de las carpetas que no tengan índice.
Options -Indexes

# Acentos y eñes correctos aunque el servidor no lo declare.
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType application/json .json
</IfModule>

# ------------------------------------------------------------
# El gestor de git de Hostinger despliega el repositorio entero,
# así que en el servidor quedan archivos que no son la web. No
# contienen secretos, pero no hay motivo para servirlos.
# ------------------------------------------------------------
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(backend|\.github|\.claude|\.git)(/|$)
  RedirectMatch 404 \.(md|mjs|toml|ejemplo|yml|yaml)$
  RedirectMatch 404 ^/(package\.json|wrangler\.toml|\.dev\.vars)$
</IfModule>

# ------------------------------------------------------------
# Caché: la web es estática y cambia poco. El HTML no se cachea
# para que los plazos de las convocatorias se vean al día.
# ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 7 days"
  ExpiresByType application/javascript    "access plus 7 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType image/webp                "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# ------------------------------------------------------------
# PENDIENTE: activar cuando el dominio propio esté apuntando a
# Hostinger y tenga el certificado emitido. Antes de eso, una
# redirección puede dejar la web inaccesible.
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
#   RewriteCond %{HTTP_HOST} ^www\.valentramites\.com$ [NC]
#   RewriteRule ^ https://valentramites.com%{REQUEST_URI} [L,R=301]
# </IfModule>
# ------------------------------------------------------------
